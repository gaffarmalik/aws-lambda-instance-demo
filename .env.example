# local = filesystem objects + explicit rule-based model simulation
# aws = real S3 + Bedrock; start with npm run dev:aws
DEMO_MODE=local
PORT=3001
# Local-only collector; do not use a cluster/process manager with >1 process.
HOST=127.0.0.1
AWS_REGION=us-east-1
S3_BUCKET=
# Set an enabled Converse-compatible model ID or inference profile ID in AWS mode.
BEDROCK_MODEL_ID=
MODEL_REQUEST_SIZE=10
# Optional for a long workshop; limits memory to prevent unbounded collection on upload failure.
MAX_BUFFER_SIZE=10000
